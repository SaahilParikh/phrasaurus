# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtualenvs
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Type checkers
.mypy_cache/
.dmypy.json
.pyre/
.pytype/

# ---- Lambda packaging ----
# We build the Lambda deployment zip under backend/build/ — never commit it.
backend/build/
backend/dist/
backend/*.zip

# ---- Node / frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store

# ---- Secrets ----
.env
.env.local
*.pem
*.key

# ---- Terraform ----
# Local init dirs and ephemeral plan files — lock file IS committed.
**/.terraform/
*.tfplan
tfplan
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
